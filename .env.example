# ── TELEGRAM ──────────────────────────────────────────────
# Отримати від @BotFather у Telegram: /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш Telegram @username або chat_id (бот надішле вам повідомлення)
# Щоб дізнатись свій chat_id: напишіть /start вашому боту, потім
# відкрийте: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# ── GOOGLE CALENDAR ────────────────────────────────────────
# console.cloud.google.com → New Project → Enable Calendar API
# → Credentials → Service Account → Download JSON
# Вставте весь JSON одним рядком або вкажіть шлях до файлу
GOOGLE_SERVICE_ACCOUNT_JSON={}
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com

# ── EMAIL (для клієнтів) ───────────────────────────────────
# Gmail: увімкніть "App Passwords" у Google Account → Security
SMTP_USER=olkastudio@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Olka Studio <olkastudio@gmail.com>

# ── ADMIN ──────────────────────────────────────────────────
# Пароль для входу в адмін-панель (придумайте свій)
ADMIN_PASSWORD=olka2024secret

# ── APP ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
